pub fn main() -> Result[(), Error] uses io {
  // Unicode case, decomposition and properties agree with Python's str methods
  let s = "Ñandú PINGÜINO Straße İstanbul ǅemal ﬁ² ①"
  io.println(s.to_lower())
  io.println("ΟΔΟΣ ΣΑΣ Σ ΑΣ. ἈΣ Σ'Α".to_lower())
  io.println(s.to_upper())
  io.println(s.to_lower().nfkd().strip_marks())
  io.println("{"한국".nfkd().len()} {"ȩ́".nfkd() == "ȩ́"} {"ὦ".nfkd().strip_marks()}")
  io.println(
    "{"añoΩ".is_alphabetic()} {"x²".is_alphanumeric()} {"  　".is_whitespace()} {"€".is_alphabetic()}",
  )
  io.println("[{"  hola 　".trim()}]")
  // regex \w and \b follow the same definition
  let w = re.compile(r"\b\w+\b")?
  io.println("{w.find_all("niño café x²·y").map(|m| m.text)}")
  // digests
  io.println(hash.sha1("abc".to_bytes()))
  io.println(hash.sha1("".to_bytes()))
  io.println(hash.sha256("abc".to_bytes()))
  io.println(hash.sha256("a".repeat(1000).to_bytes()))
  io.println(hash.sha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_bytes()))
  io.println("{hash.fnv1a("hola".to_bytes())}")
  // sets
  let a = Set.of(["a", "b", "c"])
  let b = Set.of(["b", "c", "d"])
  io.println(
    "{a.difference(b)} {a.intersection(b).is_subset(a)} {a.is_subset(b)} {Set.of([1]).difference(Set.of([1])).is_empty()}",
  )
  Ok(())
}
