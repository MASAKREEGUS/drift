enum AppError {
  Io(fs.IoError)
  Parse { line: Int }
}

fn parse_all(lines: List[Str]) -> Result[List[Int], AppError] {
  var out: List[Int] = []
  for (i, l) in lines.enumerate() {
    match l.trim().parse_int() {
      Some(n) => out.push(n)
      None => return Err(AppError.Parse { line: i + 1 })
    }
  }
  Ok(out)
}

fn load(path: Str) -> Result[Int, AppError] uses fs {
  let text = fs.read_str(path)?
  let nums = parse_all(text.lines())?
  Ok(nums.sum())
}

fn first_even(xs: List[Int]) -> Option[Int] {
  let x = xs.filter(|x| x % 2 == 0).first()?
  Some(x * 10)
}

pub fn main() -> Result[(), Error] uses io, fs {
  let p = fs.temp_path("nums")?
  fs.write_str(p, "1\n2\n 3 \n")?
  io.println("{load(p)}")
  fs.write_str(p, "1\nx\n")?
  io.println("{load(p)}")
  match load("/no/such/file") {
    Err(AppError.Io(e)) => io.println("io error on {e.path}")
    other => io.println("unexpected {other}")
  }
  io.println("{first_even([1, 3, 4])} {first_even([1, 3])}")
  fs.remove(p)?
  let n = fs.read_str("/no/such/file")?
  io.println(n)
  Ok(())
}
