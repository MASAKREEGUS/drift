/// Offer validation for a deal aggregator: detect fake discounts.

pub struct Offer { sku: Str, store: Str, price: Int, reference: Int, history: List[Int] }

pub enum OfferError {
  AboveReference { price: Int, reference: Int }
  InflatedReference { reference: Int, median: Int }
  NoHistory
}

pub enum Verdict {
  Real { discount: Int }
  Fake { reason: OfferError }
}

fn median(xs: List[Int]) -> Option[Int] {
  if xs.is_empty() {
    return None
  }
  let sorted = xs.sorted()
  Some(sorted[sorted.len() / 2])
}

examples median {
  median([]) == None
  median([5, 1, 3]) == Some(3)
}

pub fn discount(price: Int, reference: Int) -> Result[Int, OfferError]
  requires reference > 0
  requires price >= 0
{
  if price > reference {
    return Err(OfferError.AboveReference { price, reference })
  }
  Ok((reference - price) * 100 / reference)
}

examples discount {
  discount(80, 100) == Ok(20)
  discount(120, 100) == Err(OfferError.AboveReference { price: 120, reference: 100 })
}

/// A reference price is inflated when it exceeds the 90-day median by more than 15%.
pub fn verdict(self: Offer) -> Verdict {
  let check = || -> Result[Int, OfferError] {
    let med = median(self.history).ok_or(OfferError.NoHistory)?
    if self.reference * 100 > med * 115 {
      return Err(OfferError.InflatedReference { reference: self.reference, median: med })
    }
    discount(self.price, med)
  }
  match check() {
    Ok(d) => Verdict.Real { discount: d }
    Err(e) => Verdict.Fake { reason: e }
  }
}

examples verdict {
  Offer { sku: "a", store: "s", price: 70, reference: 100, history: [100, 98, 102] }.verdict() ==
    Verdict.Real { discount: 30 }
  Offer { sku: "b", store: "s", price: 70, reference: 200, history: [100, 98, 102] }.verdict() ==
    Verdict.Fake { reason: OfferError.InflatedReference { reference: 200, median: 100 } }
}
