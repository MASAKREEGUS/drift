/// Drift prelude: every name here is in scope in every module.
/// Types without fields are built into the runtime. Bodies marked `todo` are native.
pub struct Int {}
pub struct I32 {}
pub struct U8 {}
pub struct U32 {}
pub struct U64 {}
pub struct Float {}
pub struct F32 {}
pub struct Bool {}
pub struct Str {}
pub struct Bytes {}
pub struct Never {}
pub struct List[T] {}
pub struct Map[K, V] {}
pub struct Set[T] {}
pub struct Range {}
pub struct Task[T] {}
pub struct Sender[T] {}
pub struct Receiver[T] {}

pub enum Option[T] {
  Some(T)
  None
}

pub enum Result[T, E] {
  Ok(T)
  Err(E)
}

/// Catch-all error for scripts: `?` converts any error into it.
pub struct Error { message: Str }

pub fn error(message: Str) -> Error { todo }
pub fn panic(message: Str) -> Never { todo }
pub fn channel[T](capacity: Int) -> (Sender[T], Receiver[T])
  requires capacity >= 0
{
  todo
}

