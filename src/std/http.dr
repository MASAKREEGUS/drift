/// HTTP/1.1 client (http and https) and a small server.
/// `get` and `post` follow redirects and return `Err` for status >= 400; `request` returns any status.
pub struct HttpError { message: Str, status: Int }
pub struct Request { method: Str, path: Str, query: Map[Str, Str], headers: Map[Str, Str], body: Str }
pub struct Response {}
pub fn get(url: Str) -> Result[Response, HttpError] uses net { todo }
pub fn post(url: Str, body: Str) -> Result[Response, HttpError] uses net { todo }
pub fn request(method: Str, url: Str, headers: Map[Str, Str], body: Str) -> Result[Response, HttpError] uses net { todo }
